# =============================================================================
# TravelAI Platform — Official API Integration & Environment Configuration
# =============================================================================
# Copy this file to `backend/.env`.
# By default, the system runs in Mock Mode (`USE_MOCK_PROVIDERS=true`) when no
# official provider keys are set. Adding keys for any provider below and setting
# `USE_MOCK_PROVIDERS=false` activates that provider automatically without code changes.

APP_ENV=development
USE_MOCK_PROVIDERS=true
USE_LIVE_APIS=true
DATABASE_URL=sqlite:///./travelai.db

# HTTP Client Resilience & Caching
HTTP_TIMEOUT_SECONDS=12.0
HTTP_MAX_RETRIES=2
CACHE_TTL_SECONDS=600

# =============================================================================
# 1. OFFICIAL HOTEL APIS
# =============================================================================

# 1.1 Booking.com Demand API v3.1
# Docs: https://developers.booking.com/demand/docs/open-api/demand-api
# Portal: https://admin.booking.com/partner/ (Requires Managed Affiliate Partner status)
# Rate Limit: 50 requests/minute
BOOKING_DEMAND_API_TOKEN=
BOOKING_AFFILIATE_ID=
BOOKING_DEMAND_BASE_URL=https://demandapi.booking.com/3.1

# 1.2 Agoda Affiliate Lite API
# Docs: https://developer.pps.agoda.com / http://affiliate.agoda.com
# Portal: https://partners.agoda.com (Requires approved Agoda Partner account)
# Auth header format: `Authorization: <AGODA_SITE_ID>:<AGODA_API_KEY>`
AGODA_SITE_ID=
AGODA_API_KEY=
AGODA_AFFILIATE_BASE_URL=https://affiliateapi7643.agoda.com/affiliateservice/lt_v1

# 1.3 Trip.com Partner / Alliance API (Skeleton + Official Search Redirect)
# Docs / Portal: https://alliance.trip.com (Closed partner specification)
TRIPCOM_ALLIANCE_ID=
TRIPCOM_SID=
TRIPCOM_API_KEY=
TRIPCOM_BASE_URL=https://openservice.trip.com

# 1.4 Tripadvisor Content API v1 (Content Only: description, photos, rating, reviews — NO prices)
# Docs: https://tripadvisor-content-api.readme.io/reference/overview
# Portal: https://www.tripadvisor.com/developers (Self-service registration, 5000 calls/month free)
TRIPADVISOR_API_KEY=
TRIPADVISOR_BASE_URL=https://api.content.tripadvisor.com/api/v1
TRIPADVISOR_DAILY_QUOTA=160

# =============================================================================
# 2. OFFICIAL AIRLINE APIS
# =============================================================================

# 2.1 Lufthansa Group Open API (LH, LX, OS, SN)
# Docs & Portal: https://developer.lufthansa.com/docs (Open developer registration)
# Public API covers schedules, flightstatus, seatmaps, reference data.
# Partner API (`LUFTHANSA_PARTNER_ID`) enables live fares & direct booking deep-links.
LUFTHANSA_CLIENT_ID=
LUFTHANSA_CLIENT_SECRET=
LUFTHANSA_PARTNER_ID=
LUFTHANSA_BASE_URL=https://api.lufthansa.com/v1

# 2.2 Turkish Airlines NDC / Official Developer Portal (Skeleton)
# Docs & Portal: https://developer.turkishairlines.com
TURKISH_AIRLINES_API_KEY=
TURKISH_AIRLINES_API_SECRET=

# 2.3 Transavia Official Developer API (Skeleton)
# Docs & Portal: https://developer.transavia.com
TRANSAVIA_API_KEY=

# =============================================================================
# 3. AI / LLM PROVIDERS (Optional for Natural Language Trip Planning)
# =============================================================================
GEMINI_API_KEY=
LLM_API_KEY=

# =============================================================================
# 4. DEPRECATED PROVIDERS (DO NOT USE FOR NEW INTEGRATIONS)
# =============================================================================
# @deprecated: Amadeus for Developers Self-Service portal shuts down on 2026-07-17.
# Disabled by default in ProviderRegistry. Kept only for legacy backward compatibility.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# =============================================================================
# 5. SERVER & CORS CONFIGURATION
# =============================================================================
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
