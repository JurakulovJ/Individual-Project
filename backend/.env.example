# =============================================================================
# TravelAI Platform — Backend Environment Configuration (`backend/.env.example`)
# =============================================================================
APP_ENV=development
USE_MOCK_PROVIDERS=true
USE_LIVE_APIS=true
DATABASE_URL=sqlite:///./travelai.db

# HTTP Client Resilience & Caching
HTTP_TIMEOUT_SECONDS=12.0
HTTP_MAX_RETRIES=2
CACHE_TTL_SECONDS=600

# 1. Official Hotel Providers
# Booking.com Demand API v3.1 (https://developers.booking.com/demand/docs/open-api/demand-api)
BOOKING_DEMAND_API_TOKEN=
BOOKING_AFFILIATE_ID=
BOOKING_DEMAND_BASE_URL=https://demandapi.booking.com/3.1

# Agoda Affiliate API (https://developer.pps.agoda.com)
AGODA_SITE_ID=
AGODA_API_KEY=
AGODA_AFFILIATE_BASE_URL=https://affiliateapi7643.agoda.com/affiliateservice/lt_v1

# Trip.com Alliance Partner API (https://alliance.trip.com)
TRIPCOM_ALLIANCE_ID=
TRIPCOM_SID=
TRIPCOM_API_KEY=
TRIPCOM_BASE_URL=https://openservice.trip.com

# Tripadvisor Content API v1 — Content only, no prices (https://tripadvisor-content-api.readme.io/reference/overview)
TRIPADVISOR_API_KEY=
TRIPADVISOR_BASE_URL=https://api.content.tripadvisor.com/api/v1
TRIPADVISOR_DAILY_QUOTA=160

# 2. Official Airline Providers
# Lufthansa Group Open API (https://developer.lufthansa.com/docs)
LUFTHANSA_CLIENT_ID=
LUFTHANSA_CLIENT_SECRET=
LUFTHANSA_PARTNER_ID=
LUFTHANSA_BASE_URL=https://api.lufthansa.com/v1

# Turkish Airlines NDC Skeleton (https://developer.turkishairlines.com)
TURKISH_AIRLINES_API_KEY=
TURKISH_AIRLINES_API_SECRET=

# Transavia Developer API Skeleton (https://developer.transavia.com)
TRANSAVIA_API_KEY=

# 3. AI / LLM Providers
GEMINI_API_KEY=
LLM_API_KEY=

# 4. Deprecated (Amadeus Self-Service sunset: 2026-07-17 — disabled by default)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# 5. Server & CORS
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
